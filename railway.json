{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildPacks": {
      "node": "22"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheck": {
      "path": "/api/health",
      "port": 3000,
      "initialDelaySeconds": 30,
      "periodSeconds": 30,
      "timeoutSeconds": 10
    }
  }
}