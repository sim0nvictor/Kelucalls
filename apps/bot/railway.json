{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run bot:build"
  },
  "deploy": {
    "startCommand": "npm run bot:start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
"nixpacksPlan": {
  "phases": {
    "install": {
      "cmds": ["npm i -g npm@11", "npm ci"]
    }
  }
}
}