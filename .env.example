# ──────────────────────────────────────────────────
# KeluCall — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────

# ─── Supabase (Required) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Admin Panel ──────────────────────────────────
ADMIN_LOGIN_USERNAME="admin"
ADMIN_LOGIN_PASSWORD="your-admin-password"
ADMIN_SESSION_SECRET="your-session-secret-min-32-chars"

# ─── Simulation ──────────────────────────────────
SIMULATED_INVESTMENT_PER_CALL="10"

# ─── Telegram Scraper (only needed for scraper) ──
TELEGRAM_API_ID="your-telegram-api-id"
TELEGRAM_API_HASH="your-telegram-api-hash"
TELEGRAM_SESSION=""

# ─── Scraper Supabase (aliases for index.js) ─────
# The scraper uses different env var names.
# Set these to the same values as above:
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
